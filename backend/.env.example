# Backend Configuration Example
# Copy this to .env and update with your actual API keys

# OpenAI API Key - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-actual-openai-api-key-here"

# VirusTotal API Key - Get from https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY="your-virustotal-api-key-here"

# AbuseIPDB API Key - Get from https://www.abuseipdb.com/api
ABUSEIPDB_API_KEY="your-abuseipdb-api-key-here"

# Database URL
# For development (SQLite):
DATABASE_URL="sqlite:///./cti_dashboard.db"

# For production (PostgreSQL):
# DATABASE_URL="postgresql://user:password@host:5432/cti_dashboard"

# JWT Security - Generate a strong random string in production
SECRET_KEY="your-super-secret-jwt-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - Allowed frontend URLs (comma-separated)
# Local development:
FRONTEND_URLS="http://localhost:3000"

# Production:
# FRONTEND_URLS="https://your-app-name.pages.dev,https://your-domain.com"

# Project Name
PROJECT_NAME="CTI-NLP Threat Dashboard API"
